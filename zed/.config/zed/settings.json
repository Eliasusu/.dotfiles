// Zed settings — gestionado por el repo dotfiles
// `zed: open default settings` muestra todas las opciones
{
  "cli_default_open_behavior": "new_window",
  "markdown_preview": {
    "font_size": 12.0,
  },
  "diff_view_style": "unified",
  "project_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "base_keymap": "VSCode",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Tokyo Night"
  },
  "auto_install_extensions": {
    "tokyo-night": true,
    "java": true,
    "dockerfile": true,
    "toml": true
  },
  "icon_theme": "Base Charmed Icons",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 12.0,
  "ui_font_size": 15.0,
  "format_on_save": "modifications",
  "minimap": {
    "show": "never",
    "thumb": "always"
  },
  "terminal": {
    "font_size": 12.0
  },
  "session": {
    "trust_all_worktrees": true
  },
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  }
}
