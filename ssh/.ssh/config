# ~/.ssh/config — lo común a todas las máquinas.
#
# Gancho: cada archivo de ~/.ssh/config.d/ se carga acá (el repo privado pone
# los hosts del trabajo). En ssh gana el PRIMER valor que aparece para cada opción, por eso el Include va antes que el bloque genérico.
Include config.d/*

Host *
  AddKeysToAgent yes
  ServerAliveInterval 60
