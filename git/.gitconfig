[user]
	name = Elias
	email = eliasrenepalamidessi@gmail.com

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[rebase]
	autoStash = true

[merge]
	conflictStyle = zdiff3

# delta: diffs con colores y números de línea (git diff, git log -p, lazygit)
[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	syntax-theme = tokyonight_night

[alias]
	st = status -sb
	lg = log --oneline --graph --decorate -20
	undo = reset --soft HEAD~1

# Repos de la Muni: el email del trabajo se carga desde ~/.gitconfig-work
# (lo pone el repo privado; si el archivo no existe, git lo ignora)
[includeIf "gitdir:~/Workspace/muni/"]
	path = ~/.gitconfig-work
