{
  "permissions": {
    "deny": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git tag -a*)",
      "Bash(git tag -s*)",
      "Bash(git push --tags*)",
      "Bash(gh pr create*)",
      "Bash(glab mr create*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    }
  },
  "theme": "dark",
  "verbose": false,
  "autoScrollEnabled": false,
  "agentPushNotifEnabled": true
}
